@using WebMVC.Models
@model CreateChannelModel

<div class="modal fade" id="createChannelModal" tabindex="-1" aria-labelledby="createChannelModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createDmModalLabel">Create Channel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-controller="Chat" asp-action="CreateChannel">
                    <div class="row g-3">
                        <div class="col-12">
                            <div>
                                <label asp-for="ChannelName"  class="form-label">Channel Name</label>
                                <input type="text" class="form-control"  asp-for="ChannelName" placeholder="Enter Username">
                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="hstack gap-2 justify-content-end">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-primary">Create</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
